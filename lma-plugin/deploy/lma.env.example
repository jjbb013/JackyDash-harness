# LMA 插件环境变量模板 —— 复制到 /etc/dsh/lma.env 并 chmod 600
# 本文件含敏感信息（SMTP/IMAP 密码），权限务必 600，且不要提交进仓库。

# ---------- 运行环境（目标④：Linux 视为服务器，必须配公网地址）----------
# 对外地址决定：邮件页脚里的退订链接 + Cookie 的 Secure/__Host- 前缀
# 单域名方案：聊天 UI 在根路径、LMA 仪表盘挂在 /lma 子路径（见 deploy/Caddyfile）
LMA_PUBLIC_URL=https://jackydash.will-pan.com/lma

# 数据库放在仓库之外（升级时不会被动到；也避免误提交）
LMA_DB_PATH=/var/lib/dsh/lma.db

# 插件 Web 服务端口（只绑 127.0.0.1，由反向代理对外）
LMA_HTTP_PORT=3081

# ---------- 账号与会话 ----------
# 首个管理员（仅当 lma_user 为空时生效）。不设密码则生成一次性密码打印到 journal 并强制首登改密。
LMA_ADMIN_USER=will
# LMA_ADMIN_PASSWORD=<建议留空，从 journalctl 取一次性密码>

# Agent 工具的**服务身份**：角色以 lma_user 中该账号为准（可在「人员管理」里改）
LMA_AGENT_USER=harness-agent
LMA_AGENT_ROLE=admin

# 密码哈希强度（默认 65536 = 2^16，约 64MiB；2G 小机器够用）
# LMA_SCRYPT_N=65536

# HTTP 退订端点（/unsubscribe）token 的 HMAC 密钥。
# 默认值是公开的 'lma-dev-secret'，公网部署必须换成强随机值，否则任何人都能伪造退订链接。
# install.sh 会自动生成；手工部署请用：head -c 48 /dev/urandom | base64 | tr -d '/+='
LMA_COOKIE_SECRET=REPLACE_ME

# ---------- 发信 SMTP ----------
# ⚠️ 下面全是**占位符**，必须换成你自己的账号。
# 本文件是公开仓库里的模板，**绝不要把真实邮箱地址或密码写进来**（会被密钥扫描器命中）。
# Gmail 需用「应用专用密码」（先开两步验证）：https://myaccount.google.com/apppasswords
LMA_SMTP_HOST=smtp.gmail.com
LMA_SMTP_PORT=465
LMA_SMTP_SECURE=true
LMA_SMTP_USER=you@example.com
LMA_SMTP_PASS=PASTE_YOUR_APP_PASSWORD
LMA_MAIL_FROM=you@example.com

# ---------- 收信 IMAP（回复 / 退信 / 退订关键词识别，每 5 分钟轮询）----------
LMA_IMAP_ENABLED=true
LMA_IMAP_HOST=imap.gmail.com
LMA_IMAP_PORT=993
LMA_IMAP_TLS=true
LMA_IMAP_USER=you@example.com
LMA_IMAP_PASS=PASTE_YOUR_APP_PASSWORD

# ---------- 可选 ----------
# AI 端点建议在网页「配置」里填（存库、可随时改）；这里仅在从未保存过网页配置时作为兜底
# LMA_AI_MODE=api
# LMA_AI_URL=https://api.deepseek.com/v1
# LMA_AI_KEY=REPLACE_ME
# LMA_AI_MODEL=deepseek-chat

# 日志（vite/tsx 相关）保持安静
NODE_ENV=production
